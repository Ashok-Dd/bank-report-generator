    "anniversaryMilestone": "NNth anniversary in YYYY",
    "rows": [
      { "field": "Institution Name",       "value": "Full Legal Name",              "notes": "Legal / trade name note",          "reference": "[1]"  },
      { "field": "Headquarters",           "value": "City, State, Country",         "notes": "HQ established note",              "reference": "[1]"  },
      { "field": "Ticker / Exchange",      "value": "TICK / EXCHANGE",              "notes": "Listing history note",             "reference": "[1]"  },
      { "field": "Report Period",          "value": "FY YYYY / QN",                 "notes": "Fiscal year-end date",             "reference": "[1]"  },
