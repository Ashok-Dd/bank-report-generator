      { "field": "Geographic Footprint",   "value": "Region1, Region2, Region3",    "notes": "Branch or office count",          "reference": "[1]"  },
      { "field": "Key Strategic Investor", "value": "Investor1 X.X%, Investor2 X.X%","notes": "Filing date / source",           "reference": "[N]"  },
      { "field": "Anniversary Milestone",  "value": "NNth anniversary in YYYY",     "notes": "Founded note",                    "reference": "[1]"  }
